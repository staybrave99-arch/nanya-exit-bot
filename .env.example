# ── ntfy ─────────────────────────────────────
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=Exit2408
# 自架或有加密的 ntfy 才需要
NTFY_TOKEN=

# ── 執行 ─────────────────────────────────────
# Fly.io 上要指到 volume 掛載點，狀態才不會隨機器重建消失
STATE_PATH=/data/state.json
CACHE_CSV=/data/price_cache.csv
SEED_CSV=data/seed_history.csv

TZ_NAME=Asia/Taipei
RUN_AT=20:00
HTTP_TIMEOUT=30
